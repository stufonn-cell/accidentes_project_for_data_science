# Copy this file to infra/.env and fill it in. infra/.env is git-ignored.
# You can reuse the values of .envs/aws.env and .envs/sls.env of the labs.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only if your credentials are temporary (they come with a session token)
# AWS_SESSION_TOKEN=

SERVERLESS_ACCESS_KEY=

# Optional: email that receives a message when the pipeline fails
# ALERT_EMAIL=
